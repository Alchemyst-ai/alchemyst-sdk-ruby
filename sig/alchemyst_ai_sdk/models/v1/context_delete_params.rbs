        {
          by_doc: bool?,
          by_id: bool?,
          organization_id: String?,
          source: String,
          user_id: String?
        }
        & AlchemystAISDK::Internal::Type::request_parameters

      class ContextDeleteParams < AlchemystAISDK::Internal::Type::BaseModel
