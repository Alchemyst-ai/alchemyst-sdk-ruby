        attr_accessor by_doc: bool?

        attr_accessor by_id: bool?

        attr_accessor organization_id: String?

        attr_reader source: String?

        def source=: (String) -> String

        attr_accessor user_id: String?

        def initialize: (
          ?by_doc: bool?,
          ?by_id: bool?,
          ?organization_id: String?,
          ?source: String,
          ?user_id: String?,
          ?request_options: AlchemystAISDK::request_opts
