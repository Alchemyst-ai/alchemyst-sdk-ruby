module Alchemystai
  module Resources
    class V1
      class Context
        attr_reader traces: Alchemystai::Resources::V1::Context::Traces

        attr_reader view: Alchemystai::Resources::V1::Context::View

        attr_reader memory: Alchemystai::Resources::V1::Context::Memory

        def delete: (
          ?by_doc: bool?,
          ?by_id: bool?,
          ?organization_id: String?,
          ?source: String,
          ?user_id: String?,
          ?request_options: Alchemystai::request_opts
        ) -> top

        def add: (
          ?context_type: Alchemystai::Models::V1::ContextAddParams::context_type,
          ?documents: ::Array[Alchemystai::V1::ContextAddParams::Document],
          ?metadata: Alchemystai::V1::ContextAddParams::Metadata,
          ?scope: Alchemystai::Models::V1::ContextAddParams::scope,
          ?source: String,
          ?request_options: Alchemystai::request_opts
        ) -> top

        def search: (
          minimum_similarity_threshold: Float,
          query: String,
          similarity_threshold: Float,
          ?metadata: top,
          ?scope: Alchemystai::Models::V1::ContextSearchParams::scope,
          ?user_id: String,
          ?request_options: Alchemystai::request_opts
        ) -> Alchemystai::Models::V1::ContextSearchResponse

        def initialize: (client: Alchemystai::Client) -> void
      end
    end
  end
end
